# ==============================================================================
# CloudNotes Terraform Input Variables Example
# Copy this file to terraform.tfvars and customize for your deployment
# ==============================================================================

# AWS Region to deploy into (e.g. eu-west-1, us-east-1, af-south-1)
aws_region = "eu-west-1"

# Environment tag & resource naming prefix
project_name = "cloudnotes"
environment  = "prod"

# EC2 Compute Settings
instance_type   = "t3.micro"
key_name        = null  # Set to your EC2 Key Pair name if SSH access is required
container_image = "ghcr.io/monchokk/cloud-notes:latest"
app_port        = 8080

# RDS Database Settings
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_engine_version    = "16.3"
db_name              = "cloudnotes"
db_username          = "cloudnotes"
db_password          = "ChangeMeToASecurePassword123!"

# Networking CIDRs (Optional overrides)
# vpc_cidr              = "10.0.0.0/16"
# public_subnet_cidr    = "10.0.1.0/24"
# private_subnet_1_cidr = "10.0.2.0/24"
# private_subnet_2_cidr = "10.0.3.0/24"

tags = {
  Project     = "CloudNotes"
  Environment = "Production"
  ManagedBy   = "Terraform"
}

