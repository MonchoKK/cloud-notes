# ==============================================================================
# CloudNotes Environment Configuration Template
# Copy this file to .env before starting Docker Compose services:
#   cp .env.example .env
# ==============================================================================

# Application Port
APP_PORT=8080

# Active Spring Profile (e.g. 'local', 'prod')
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cloudnotes
DB_USER=cloudnotes
DB_PASSWORD=cloudnotes_secret

# JVM Memory and Performance Tuning
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
